# Swift Package Manager
.build/
.swiftpm/

# Package.resolved IS committed. Tally is an application, not a library, so builds should be
# reproducible: leaving it out let two CI jobs in the same run resolve different GRDB versions
# (7.8.0 and 7.11.1), which is how a link failure appeared on one platform and not the other.

# Xcode — the project is generated from project.yml by XcodeGen, never committed.
# Run `xcodegen generate` after cloning. See README.
Tally.xcodeproj/
*.xcworkspace/
DerivedData/
build/
*.xcuserstate
*.xcscmblueprint

# Also generated by XcodeGen, from the `info:` blocks in project.yml. Committing these would
# fork the source of truth: the file on disk would keep whatever it had while project.yml drifted.
App/Info.plist
Widget/Info.plist

# macOS
.DS_Store

# Local configuration. Holds your Apple Team ID and bundle prefix — identifying, and this
# repository is public. The tracked template is .env.example; the real file never lands here.
.env
.env.*
!.env.example

# Secrets — provider API keys are entered in-app and stored in the Keychain, one item per
# provider. Nothing here should ever hold one.
*.p8
*.p12
*.mobileprovision
Secrets.xcconfig

# The base64 of any of the above, which is what you paste into a GitHub secret. Same bytes,
# same Team ID and device UDIDs inside, but `*.mobileprovision` does not match
# `profile.mobileprovision.b64` — so the encoded copy was the one that could still be
# committed by accident.
*.b64
