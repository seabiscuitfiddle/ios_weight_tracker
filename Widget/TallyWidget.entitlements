<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Deliberately the *app's* group, not one derived from the widget's own bundle identifier.
	The widget is <prefix>.tally.widget, but both processes must open the same container, so
	APP_GROUP_ID resolves to group.<prefix>.tally for the app and the widget alike — which is
	what TallyDatabase.appGroupIdentifier(for:) computes at runtime by stripping ".widget".
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_ID)</string>
	</array>
</dict>
</plist>
