<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Capabilities for the app target.

  The App Group must match Widget/TallyWidget.entitlements exactly and be registered in the
  Apple developer portal. A mismatch is not a build error: the app and widget simply get
  separate containers, and the widget shows no data forever.

  The values below expand from BUNDLE_ID_PREFIX in project.yml, so changing your bundle prefix
  is a single edit there rather than a hunt through these files.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.$(BUNDLE_ID_PREFIX).tally</string>
    </array>

    <!-- Read-only Health access: weight and workout energy. Tally never writes to Health. -->
    <key>com.apple.developer.healthkit</key>
    <true/>
    <key>com.apple.developer.healthkit.access</key>
    <array/>

    <!--
      Holds the user's Anthropic API key. Scoped to the app alone, not shared with the widget:
      the widget only ever reads already-stored numbers and has no reason to be able to reach
      a credential.
    -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)$(BUNDLE_ID_PREFIX).tally</string>
    </array>
</dict>
</plist>
