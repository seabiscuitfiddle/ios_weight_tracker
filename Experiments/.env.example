# Copy to `Experiments/.env` and fill in the providers you want to measure. The repository's
# .gitignore already excludes `.env` and `.env.*` while keeping this template, so a real key
# cannot be committed by accident.
#
# Only the providers you actually name in a RunConfig need a key. Everything else is skipped.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
