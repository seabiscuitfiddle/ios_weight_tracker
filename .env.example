# Copy to `.env` and fill in. `.env` is gitignored and must stay that way — every value here
# identifies you or your Apple account, and this repository is public.
#
#     cp .env.example .env
#     ./scripts/bootstrap.sh
#
# Nothing in here is needed to build and run on the simulator. The defaults in project.yml are
# enough for that, which is why a fresh clone works with no setup at all.

# A reverse-DNS prefix you own, e.g. dev.yourname. Targets become <prefix>.tally and
# <prefix>.tally.widget, the App Group group.<prefix>.tally, and the keychain group likewise.
# Leave unset to keep the com.example placeholder.
BUNDLE_ID_PREFIX=

# Your 10-character Apple Developer Team ID, from Xcode › Settings › Accounts. Needed only to
# install on a physical device. It is not a password, but it does identify your developer
# account, so it does not belong in a tracked file.
DEVELOPMENT_TEAM=

# There is deliberately no API key here, for any provider.
#
# Nothing in this repository reads one: not the app, not the build, not CI. You pick a provider
# in Settings → AI logging and paste its key there, and it is stored in the device keychain,
# one item per provider. A key in a build-time file would end up in the binary and in the
# history, which is exactly what the keychain exists to avoid.
#
# scripts/check-secrets.sh will stop you committing one by accident.
